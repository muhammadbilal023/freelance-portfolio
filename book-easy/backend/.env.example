# ---- BookEasy payments backend ----
# Copy to .env and fill in. NEVER commit the real .env file.

# Port the HTTP server listens on
PORT=8080

# Comma-separated list of allowed CORS origins (the mobile app is not a browser
# origin, but keep this tight for any web clients you add later).
CORS_ORIGINS=http://localhost:3000

# Stripe TEST-mode secret key (starts with sk_test_).
# Get one at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Upper bound (in the smallest currency unit, e.g. cents) accepted for a single
# PaymentIntent. Guards against malformed or abusive amounts.
MAX_AMOUNT_CENTS=100000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Set to "true" to enable pretty-printed logs in development
LOG_PRETTY=false
