# ---- SyncFlow — Business Integration Hub ----
# Copy to .env and fill in. NEVER commit the real .env file.
# Every integration is OPTIONAL: unconfigured flows fail at runtime and land
# in the dead-letter table (visible in the admin dashboard) instead of
# blocking startup.

# HTTP server
PORT=8081

# SQLite database file (use ":memory:" for a throwaway instance)
DATABASE_PATH=./data/syncflow.db

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
LOG_PRETTY=false

# ---- Job queue ----
JOB_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=300000

# ---- Webhook signature secrets (required for the webhook endpoints) ----
# Stripe: Dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Shopify: Apps > Develop apps > API credentials > Client secret
SHOPIFY_HMAC_SECRET=REPLACE_ME

# ---- Stripe (Flow 1 source; only the webhook is consumed, no API key needed) ----

# ---- Google Sheets (Flow 1 + Flow 3 target) ----
# Service-account JSON key file path (Sheet must be shared with the service
# account's client_email as Editor).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
# Spreadsheet that receives Stripe payments (Flow 1)
PAYMENTS_SHEET_ID=
PAYMENTS_SHEET_NAME=Payments
# Spreadsheet that mirrors Airtable records (Flow 3)
AIRTABLE_MIRROR_SHEET_ID=
AIRTABLE_MIRROR_SHEET_NAME=Airtable

# ---- HubSpot (Flow 1 CRM target) ----
# Private app access token (free CRM): Settings > Integrations > Private apps
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CONTACTS_LIST_ID=

# ---- Shopify (Flow 2 source; only the webhook is consumed) ----

# ---- Airtable (Flow 2 target, Flow 3 source) ----
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_ORDERS_TABLE=Orders
AIRTABLE_PULL_TABLE=Inbox

# ---- Slack (Flow 2 notification) ----
# Incoming webhook URL: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ---- Scheduled Airtable -> Sheets pull (Flow 3) ----
AIRTABLE_PULL_INTERVAL_MS=900000
